{
  "name": "express-cart-unified",
  "version": "1.0.0",
  "description": "Unified shopping cart application with Express backend, React frontend, SQLite database, and Vitest/Playwright tests",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "cd frontend && vite build && cd ..",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "vercel-build": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "cypress": "^15.17.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
